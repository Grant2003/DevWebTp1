{% extends 'core/base.html.twig' %}

{% block content %}
    <div class="confirmation-container">
        <div class="confirmation-card">
            <h1 class="text-center mb-4">Confirmation d'annulation</h1>

            <p class="lead text-center mb-4">Êtes-vous sûr de vouloir annuler la commande #{{ commande.idCommande }} ?</p>
            <p class="text-center mb-4"><strong>Le total de la commande est de {{ commande.total }} $</strong></p>

            <div class="d-flex justify-content-center mb-4">
                <form action="{{ path('route_confirmer_annulation', {id: commande.idCommande}) }}" method="POST">
                    <button type="submit" class="btn btn-danger btn-lg mx-3">Confirmer l'annulation</button>
                </form>
            </div>

            <div class="d-flex justify-content-center mb-3">
                <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg mx-2">Retour au catalogue</a>
                <a href="{{ path('route_historique') }}" class="btn btn-secondary btn-lg mx-2">Retour à l'historique des commandes</a>
            </div>
        </div>
    </div>
{% endblock %}
