{% extends 'core/base.html.twig' %}

{% block title %} Produits  {% endblock %}
{% block content %}
{% for label, messages in app.flashes %}
<div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
    {% for message in messages %}
        <p>{{ message }}</p>
    {% endfor %}
</div>
{% endfor %}
<div class="order-summary">
    <table >
    <caption>La commande sera envoyé à:</caption>
    <tr>
        <th>Adresse</th>
        <td>{{ adresse }}, {{ ville }}, {{ province }}</td>
    </tr>
    <tr>
        <th>Code Postal</th>
        <td>{{ codePostal }}</td>
    </tr>
    <tr>
        <th>Email de facturation</th>
        <td>{{ email }}</td>
    </tr>
    <tr>
        <th>Total</th>
        <td>{{ total | number_format(2, '.', ',')}}$</td>
    </tr>
    </table>
    <hr class="divider">
    <h3>
        Vous avez 48h pour annuler la commande
    </h3>
    <table>
        <td class="text-center">
            <a href="/historique" class="btn btn-secondary">Historique des commandes</a>
        </td>
        <td class="text-center">
            <a href="/" class="btn btn-secondary">Retour au catalogue</a>
        </td>
    </table>

    </tr>
</div>



{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/commande.css') }}">
{% endblock %}