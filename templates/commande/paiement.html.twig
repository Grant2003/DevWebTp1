{% extends 'core/base.html.twig' %}

{% block content %}

<style>

</style>



<form method="post" action="{{ path('confirmation') }}" onsubmit="return validerCC(this);" id="carteCr">
<h1>Paiement de la commande</h1>
  <table>
    <tr>
      <td><h3>Type de carte de crédit</h3></td>
    </tr>
    <tr>
      <td>
        <input type="radio" value="V" name="carteC" id="visa" /> <img src="/img/visa.gif" alt="Visa" />
        <input type="radio" value="M" name="carteC" /> <img src="/img/mastercard.gif" alt="MC" />
        <input type="radio" value="A" name="carteC" /> <img src="/img/amex.gif" alt="Amex" />
      </td>
    </tr>
    <tr>
      <td><h3>Saisissez le numéro (sans espace)</h3></td>
    </tr>
    <tr>
      <td><input type="text" size="20" maxlength="20" name="noCarte" /></td>
    </tr>
    <tr>
      <td><h3>Date d'expiration</h3></td>
    </tr>
    <tr>
      <td>
        <h4>
          Mois
          <select name="mois" class="credit">
            <option value="01">01</option>
            <option value="02">02</option>
            <option value="03">03</option>
            <option value="04" selected>04</option>
            <option value="05">05</option>
            <option value="06">06</option>
            <option value="07">07</option>
            <option value="08">08</option>
            <option value="09">09</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
          </select>
          &nbsp;&nbsp;Année
          <select name="annee" class="credit">
            <option value="2025">2025</option>
            <option value="2026">2026</option>
            <option value="2027">2027</option>
          </select>
        </h4>
      </td>
    </tr>
    <tr>
      <td>
        <input type="submit" value="Valider" name="ValiderCC" class="btn btn-dark" />
        <hr />
      </td>
    </tr>
  </table>
  <a href="/panierAccueil" class="btn btn-secondary">Retour au panier</a>
<a href="/" class="btn btn-secondary">Retour au catalogue</a>
</form>



{% endblock %}
{% block javascripts %}
	<script src="{{ asset('scripts/validationCommande.js') }}"></script>
{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/commande.css') }}">
{% endblock %}