{% extends 'core/base.html.twig' %}

{% block content %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        </div>
    {% endfor %}
        <div class="container mt-4">
        <h1>Modifier le produit: {{ produit.nom }}</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.description) }}
            {{ form_row(form.prix) }}
            {{ form_row(form.qtte_stock) }}
            {{ form_row(form.Qtte_seuil_min) }}
            {{ form_row(form.idCategorie) }}
            <button class="btn btn-success mt-3">Enregistrer les modifications</button>
        {{ form_end(form) }}
    </div>
    <a class="btn btn-secondary" href="{{ path('route_admin') }}"> Retour</a>

{% endblock %}