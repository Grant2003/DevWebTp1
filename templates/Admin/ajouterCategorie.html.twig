{% extends 'core/base.html.twig' %}

{% block content %}
    <div class="container mt-4 mb-5">

        {% for label, messages in app.flashes %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                {% for message in messages %}
                    <p class="mb-0">{{ message }}</p>
                {% endfor %}
            </div>
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Créer une nouvelle catégorie</h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="card p-4 shadow-sm">
        {# Form creation de categorie #}
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="text-end">
                    <a class="btn btn-secondary" href="{{ path('route_admin') }}">← Retour</a>

                    <button class="btn btn-dark">💾 Enregistrer</button>
                </div>
            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
