{% extends 'core/base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block content %}


<div class="produit-list-wrapper container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Produits</h1>
        <a class="btn btn-secondary" href="{{ path('route_admin') }}">← Retour</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <ul class="list-group shadow-sm">
        {% for produit in produits %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <strong>{{ produit.nom }}</strong>
                <a href="{{ path('route_modifier_produit', { id: produit.id }) }}" class="btn btn-outline-dark btn-sm">Modifier</a>
            </li>
        {% else %}
            <li class="list-group-item text-muted fst-italic">Aucun produit trouvé.</li>
        {% endfor %}
    </ul>
</div>


{% endblock %}