{% extends 'core/base.html.twig' %}

{% block content %}
    <div class="container mt-4 mb-5 pb-5" >

        {% for label, messages in app.flashes %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                {% for message in messages %}
                    <p class="mb-0">{{ message }}</p>
                {% endfor %}
            </div>
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="mb-0">Tous les produits du catalogue</h1>
            <a class="btn btn-secondary" href="{{ path('route_admin') }}">← Retour</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nom du produit</th>
                        <th>Prix</th>
                        <th>En stock</th>
                        <th>Seuil minimal</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td>{{ produit.nom }}</td>
                            <td>{{ produit.prix|number_format(2, ',', ' ') }} $</td>
                            <td>{{ produit.qtte_stock }}</td>
                            <td>{{ produit.Qtte_seuil_min }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-muted fst-italic">Aucun produit trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
