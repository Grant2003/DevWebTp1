{% extends 'core/base.html.twig' %}

{% block content %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        </div>
    {% endfor %}

    <a class="btn btn-secondary" href="{{ path('route_ajouter_categorie') }}"> Ajouter Categorie</a>
    <a class="btn btn-secondary" href="{{ path('route_modifier_categorie') }}"> Modifier Categorie</a>
    <a class="btn btn-secondary" href="{{ path('route_ajouter_produit') }}"> Ajouter Produit</a>
    <a class="btn btn-secondary" href="{{ path('route_modifier_produit_liste') }}"> Modifier Produit</a>
    <a class="btn btn-secondary" href="{{ path('route_rapport') }}"> Rapport sur les ventes</a>
    <a class="btn btn-secondary" href="{{ path('route_produits_catalogue') }}"> Produits du catalogue</a>
    <a class="btn btn-secondary" href="{{ path('route_a_commander') }}"> Produit à commander</a>

{% endblock %}