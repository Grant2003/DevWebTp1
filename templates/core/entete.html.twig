  <header class="py-3  border-bottom text-bg-dark">
    <div class="container">
      <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
        <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
        </a>

        <ul class="nav col-11 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
        <li class="nav-item me-3">
            <a class="nav-link px-2 text-secondary" href="{{ path('app_home') }}"> Catalogue</a>
        </li>          
        <li class="nav-item me-3">
            <a class="nav-link px-2 text-white" href="{{ path('route_contact') }}">Contact</a>
        </li>
        <li>
            <a class="nav-link px-2 text-white" href="{{ path('route_panier') }}"> Panier ({{nbItem}} items) </a>

        </li>
        </ul>



        <div class="text-end">
        
        <ul class="nav col-11 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
            {% if app.session.get('utilisateurConnecte') %}
              <li class="nav-item me-3">
                  <a class="nav-link px-2 text-white" href="{{ path('route_deconnexion') }}"> Déconnexion </a>
              </li>          
              <li class="nav-item me-3">
                  <a class="nav-link px-2 text-white" href="{{ path('route_modifier') }}"> Modifier le compte </a>
              </li>
              <li class="nav-item me-3">
                  <a class="nav-link px-2 text-white"> Commande</a>
              </li>
            {% else %}
              <li class="nav-item me-3">
                  <a class="nav-link px-2 text-white" href="{{ path('route_connexion') }}"> Connexion </a>
              </li>          
              <li class="nav-item me-3">
                  <a class="nav-link px-2 text-white" href="{{ path('route_creer') }}"> Créer un compte </a>
              </li>
            {% endif %}
        </ul>
        </div>
      </div>
    </div>
  </header>



{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/client.css') }}">
{% endblock %}
