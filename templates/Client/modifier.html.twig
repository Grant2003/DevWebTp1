{# templates/inscription/index.html.twig #}
{% extends 'core/base.html.twig' %}

{% block title %}Modifer{% endblock %}

{% block content %}
<div class="div-form  ">
<h1>Modifier le compte</h1>

    {{ form_start(form) }}
    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.prenom, 'Prénom') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.prenom, {'attr': {'placeholder': 'Votre prénom'}}) }}
            <div class="erreur">
                {{ form_errors(form.prenom) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.nom, 'Nom de famille') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.nom, {'attr': {'placeholder': 'Votre nom de famille'}}) }}
            <div class="erreur">
                {{ form_errors(form.nom) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
                {{ form_label(form.genre, 'Genre') }}
        </div>
        <div class="col-2 ">
            {{ form_widget(form.genre) }}
            <div class="erreur">
                {{ form_errors(form.genre) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.adresse, 'Adresse') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.adresse, {'attr': {'placeholder': '123 Rue Exemple'}}) }}
            <div class="erreur">
                {{ form_errors(form.adresse) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.ville, 'Ville') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.ville, {'attr': {'placeholder': 'Votre ville'}}) }}
            <div class="erreur">
                {{ form_errors(form.ville) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.province, 'Province') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.province) }}
            <div class="erreur">
                {{ form_errors(form.province) }}
            </div>        
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.codePostal, 'Code Postal') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.codePostal, {'attr': {'placeholder': 'A1A 1A1'}}) }}
            <div class="erreur">
                {{ form_errors(form.codePostal) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.telephone, 'Téléphone') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.telephone, {'attr': {'placeholder': '(123) 456-7890'}}) }}
            <div class="erreur">
                {{ form_errors(form.telephone) }}
            </div>
        </div>
    </div>

    <div class="row section-form">
    <div class="col-2 titreChampForm">
            {{ form_label(form.email, 'Adresse Email') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.email, {'attr': {'placeholder': 'exemple@domaine.com'}}) }}
            <div class="erreur">
                {{ form_errors(form.email) }}
            </div>
        </div>
    </div>

</div>
<div class="div-form  ">

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.motDePasse, 'Mot de passe') }}
        </div>
        <div class="col-1 ">
            {{ form_widget(form.motDePasse, {'attr': {'placeholder': 'Votre mot de passe'}}) }}
            <div class="erreur ">
                {{ form_errors(form.motDePasse) }}
            </div>        
        </div>
    </div>

    

    <div class="row section-form">
        <div class="col-2 titreChampForm">
            {{ form_label(form.confirmationMotDePasse, 'Confirmez le mot de passe') }}

        </div>
        <div class="col-1 ">
            {{ form_widget(form.confirmationMotDePasse, {'attr': {'placeholder': 'Confirmez votre MDP'}}) }}
            <div class="erreur ">
                {{ form_errors(form.confirmationMotDePasse) }}
            </div>
        </div>
    </div>
    <button class="btn btn-dark" type="submit">S'inscrire</button>
</div>



{{ form_end(form) }}
{% endblock %}